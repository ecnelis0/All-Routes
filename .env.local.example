# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Google Maps JavaScript API key (browser-side map). Restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenAI key for the route assistant (server-side only, never sent to the browser).
# Without it the app still works; the assistant tells you what to add.
OPENAI_API_KEY=

# Optional: which OpenAI model the assistant uses (default gpt-5.4-mini).
OPENAI_MODEL=
